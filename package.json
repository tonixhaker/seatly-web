{
  "name": "seatly-web",
  "version": "0.0.1",
  "description": "Storefront and organizer admin for Seatly",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.ts\"",
    "gen:api": "openapi-typescript \"${SEATLY_OPENAPI_SPEC:-../seatly-api/docs/openapi.json}\" -o src/api/core.gen.ts && prettier --write src/api/core.gen.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-router": "7.18.4",
    "socket.io-client": "4.8.3",
    "sonner": "2.0.8",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
